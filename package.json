{
  "name": "kitydd",
  "version": "3.3.0",
  "description": "Professional Mindmap Tool - Electron implementation of KityMinder",
  "main": "main.js",
  "author": "DDT-TDD",
  "overrides": {
    "@xmldom/xmldom": ">=0.8.15",
    "brace-expansion": ">=1.1.21",
    "electron": "^43.8.3",
    "fast-uri": ">=3.1.9",
    "http-cache-semantics": ">=4.3.0",
    "js-yaml": ">=4.3.2",
    "undici": ">=6.29.1"
  },
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-packager . KityDD --platform=win32 --arch=x64 --icon=icon.ico --overwrite",
    "build:portable": "npx electron-builder --win portable",
    "validate:release": "node scripts/validate-release.js"
  },
  "build": {
    "appId": "com.kitydd.app",
    "productName": "KityDD",
    "npmRebuild": false,
    "files": [
      "main.js",
      "local-kity-minder/**/*",
      "LICENSE",
      "THIRD_PARTY_LICENSES.md",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3"
  }
}
